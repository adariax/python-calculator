LANG=Calc
LEXER_NAME=CalcLexer
PARSER_NAME=CalcParser
ANTLR4=antlr4

.PHONY : all clean remove install

all : install ${LANG}

install :
	pip install -r requirements.txt

lexer : install Calc/${LEXER_NAME}.g4
	${ANTLR4} -Dlanguage=Python3 Calc/${LEXER_NAME}.g4

parser : install Calc/${PARSER_NAME}.g4
	${ANTLR4} -Dlanguage=Python3 -no-listener -no-visitor Calc/${PARSER_NAME}.g4

${LANG} : lexer parser clean

clean :
	rm -f Calc/${LEXER_NAME}.interp
	rm -f Calc/${LEXER_NAME}.tokens
	rm -f Calc/${PARSER_NAME}.interp
	rm -f Calc/${PARSER_NAME}.tokens
	rm -f Calc/${LEXER_NAME}.g4
	rm -f Calc/${PARSER_NAME}.g4

remove :
	rm -rf ${LANG}

